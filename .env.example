# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A anon key é pública por natureza:
# quem protege os dados são as políticas de RLS do schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: liga a leitura da Google Agenda em Atendimentos (veja o README).
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Opcional. No GitHub Pages o workflow define /<nome-do-repositorio>/.
# VITE_BASE=/
